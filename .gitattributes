# Preserve upstream source/license bytes, including their original whitespace.
data/pydantic/frozen/sources/** -text whitespace=-blank-at-eol,-blank-at-eof
data/pydantic/frozen/licenses/** -text whitespace=-blank-at-eol,-blank-at-eof
# Inspection quotes retain the original source's trailing whitespace.
data/pydantic/extraction/derived/inspection.md -text whitespace=-blank-at-eol,-blank-at-eof
